{
  "script": "build_a_graph",
  "task": {
    "statement": "On the one stream the runtime holds, add a test pattern source and a clamp in one edit; ask which of a frame sink's input and the clamp's number input a link from the source's video output fits, and read that only the frame sink's does; add a frame sink of the node type that fits; check a link from the source's video output into the clamp's number input and read why it would be refused; check the link from the source's video output to the sink's input and read that it connects; make that link; read the graph back to see the nodes and the link; then undo the three edits and read the graph back to see them gone.",
    "givens": {
      "source_node_type": "tatolab.testpattern:TestPatternSource",
      "source_label": "source",
      "source_config": { "width": 320, "height": 180 },
      "source_output": "video",
      "sink_node_type": "nodes.frame_sink:FrameSink",
      "sink_label": "sink",
      "sink_input": "video_from_upstream",
      "clamp_node_type": "nodes.clamp:Clamp",
      "clamp_label": "clamp",
      "clamp_input": "x"
    }
  },
  "steps": [
    {
      "name": "streams",
      "tool": "list_streams",
      "arguments": {},
      "expect": [
        { "at": "/streams", "has_length": 1 },
        { "at": "/streams/0/state", "equals": "running" }
      ]
    },
    {
      "name": "edit",
      "tool": "transact",
      "arguments": {
        "operations": [
          {
            "operation": "add_node",
            "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
            "type": { "$given": "source_node_type" },
            "as": { "$given": "source_label" },
            "config": { "$given": "source_config" }
          },
          {
            "operation": "add_node",
            "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
            "type": { "$given": "clamp_node_type" },
            "as": { "$given": "clamp_label" }
          }
        ]
      },
      "expect": [
        { "at": "/mode", "equals": "commit" },
        { "at": "/added_nodes", "has_length": 2 },
        { "at": "/added_nodes/0/as", "equals": { "$given": "source_label" } },
        { "at": "/added_nodes/1/as", "equals": { "$given": "clamp_label" } }
      ]
    },
    {
      "name": "node_types_the_source_feeds",
      "tool": "check_link_candidates",
      "arguments": {
        "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
        "from": { "output": { "node": { "$read": { "step": "edit", "pointer": "/added_nodes/0/node" } }, "port": { "$given": "source_output" } } },
        "among": {
          "ends": [
            { "kind": "node_type_port", "node_type": { "$given": "sink_node_type" }, "port": { "$given": "sink_input" } },
            { "kind": "node_type_port", "node_type": { "$given": "clamp_node_type" }, "port": { "$given": "clamp_input" } }
          ]
        }
      },
      "expect": [
        { "at": "/candidates", "has_length": 1 },
        { "at": "/candidates/0/end/node_type", "equals": { "$given": "sink_node_type" } },
        { "at": "/candidates/0/check/outcome", "equals": "connects" }
      ]
    },
    {
      "name": "sink_placed",
      "tool": "transact",
      "arguments": {
        "operations": [
          {
            "operation": "add_node",
            "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
            "type": { "$read": { "step": "node_types_the_source_feeds", "pointer": "/candidates/0/end/node_type" } },
            "as": { "$given": "sink_label" }
          }
        ]
      },
      "expect": [
        { "at": "/mode", "equals": "commit" },
        { "at": "/added_nodes", "has_length": 1 },
        { "at": "/added_nodes/0/as", "equals": { "$given": "sink_label" } }
      ]
    },
    {
      "name": "link_checked_into_the_clamp",
      "tool": "check_link",
      "arguments": {
        "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
        "source": { "node": { "$read": { "step": "edit", "pointer": "/added_nodes/0/node" } }, "port": { "$given": "source_output" } },
        "target": { "node": { "$read": { "step": "edit", "pointer": "/added_nodes/1/node" } }, "port": { "$given": "clamp_input" } }
      },
      "expect": [
        { "at": "/outcome", "equals": "refused" },
        { "at": "/refusal/refusal_code", "equals": "link_pin_types_do_not_connect" },
        { "at": "/refusal/action", "equals": "connect" }
      ]
    },
    {
      "name": "link_checked_into_the_sink",
      "tool": "check_link",
      "arguments": {
        "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
        "source": { "node": { "$read": { "step": "edit", "pointer": "/added_nodes/0/node" } }, "port": { "$given": "source_output" } },
        "target": { "node": { "$read": { "step": "sink_placed", "pointer": "/added_nodes/0/node" } }, "port": { "$given": "sink_input" } }
      },
      "expect": [
        { "at": "/outcome", "equals": "connects" }
      ]
    },
    {
      "name": "connected",
      "tool": "transact",
      "arguments": {
        "operations": [
          {
            "operation": "connect",
            "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
            "source": { "node": { "$read": { "step": "edit", "pointer": "/added_nodes/0/node" } }, "port": { "$given": "source_output" } },
            "target": { "node": { "$read": { "step": "sink_placed", "pointer": "/added_nodes/0/node" } }, "port": { "$given": "sink_input" } }
          }
        ]
      },
      "expect": [
        { "at": "/mode", "equals": "commit" },
        { "at": "/connected_links", "has_length": 1 },
        { "at": "/connected_links/0/source/node", "equals": { "$read": { "step": "edit", "pointer": "/added_nodes/0/node" } } },
        { "at": "/connected_links/0/target/node", "equals": { "$read": { "step": "sink_placed", "pointer": "/added_nodes/0/node" } } },
        { "at": "/connected_links/0/state", "is_one_of": ["pending", "wired"] }
      ]
    },
    {
      "name": "graph_after_the_edit",
      "tool": "graph",
      "arguments": {
        "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } }
      },
      "expect": [
        {
          "at": "/nodes",
          "holds_an_item_where": {
            "/id": { "$read": { "step": "edit", "pointer": "/added_nodes/0/node" } },
            "/type": { "$given": "source_node_type" }
          }
        },
        {
          "at": "/nodes",
          "holds_an_item_where": {
            "/id": { "$read": { "step": "sink_placed", "pointer": "/added_nodes/0/node" } },
            "/type": { "$given": "sink_node_type" }
          }
        },
        {
          "at": "/links",
          "holds_an_item_where": {
            "/source/node": { "$read": { "step": "edit", "pointer": "/added_nodes/0/name" } },
            "/source/port": { "$given": "source_output" },
            "/target/node": { "$read": { "step": "sink_placed", "pointer": "/added_nodes/0/name" } },
            "/target/port": { "$given": "sink_input" }
          }
        }
      ]
    },
    {
      "name": "link_undone",
      "tool": "undo",
      "arguments": {
        "project_directory": { "$read": { "step": "streams", "pointer": "/streams/0/location/project_directory" } }
      },
      "expect": [
        { "at": "/undoes", "equals": { "$read": { "step": "connected", "pointer": "/transaction" } } }
      ]
    },
    {
      "name": "sink_undone",
      "tool": "undo",
      "arguments": {
        "project_directory": { "$read": { "step": "streams", "pointer": "/streams/0/location/project_directory" } }
      },
      "expect": [
        { "at": "/undoes", "equals": { "$read": { "step": "sink_placed", "pointer": "/transaction" } } }
      ]
    },
    {
      "name": "undone",
      "tool": "undo",
      "arguments": {
        "project_directory": { "$read": { "step": "streams", "pointer": "/streams/0/location/project_directory" } }
      },
      "expect": [
        { "at": "/undoes", "equals": { "$read": { "step": "edit", "pointer": "/transaction" } } }
      ]
    },
    {
      "name": "graph_after_the_undo",
      "tool": "graph",
      "arguments": {
        "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } }
      },
      "expect": [
        {
          "at": "/nodes",
          "holds_no_item_where": {
            "/id": { "$read": { "step": "edit", "pointer": "/added_nodes/0/node" } }
          }
        },
        {
          "at": "/nodes",
          "holds_no_item_where": {
            "/id": { "$read": { "step": "sink_placed", "pointer": "/added_nodes/0/node" } }
          }
        },
        {
          "at": "/nodes",
          "holds_no_item_where": {
            "/id": { "$read": { "step": "edit", "pointer": "/added_nodes/1/node" } }
          }
        },
        {
          "at": "/links",
          "holds_no_item_where": {
            "/target/node": { "$read": { "step": "sink_placed", "pointer": "/added_nodes/0/name" } }
          }
        }
      ]
    }
  ]
}
