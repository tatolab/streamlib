{
  "script": "build_a_graph",
  "task": {
    "statement": "On the one stream the runtime holds, add a test pattern source, a frame sink, a clamp and a Tensor-to-audio conversion in one edit; check a link from the source's video output into the clamp's number input and read why it would be refused; check the link from the source's video output to the sink's input and read that it connects; make that link; read the graph back to see the nodes and the link; check the link from the source's video output into the conversion's Tensor input and read the convert node it would get; make that link, read the convert node it got under the added nodes and in the graph; undo it and read the graph back to see the convert node gone; then undo the first two edits and read the graph back to see them gone.",
    "givens": {
      "source_node_type": "tatolab.testpattern:TestPatternSource",
      "source_label": "source",
      "source_config": { "width": 320, "height": 180 },
      "source_output": "video",
      "sink_node_type": "nodes.frame_sink:FrameSink",
      "sink_label": "sink",
      "sink_input": "video_from_upstream",
      "clamp_node_type": "nodes.clamp:Clamp",
      "clamp_label": "clamp",
      "clamp_input": "x",
      "tensor_sink_node_type": "tatolab.stream:TensorToAudio",
      "tensor_sink_label": "audio_from_tensor",
      "tensor_sink_input": "array",
      "convert_node_type": "tatolab.stream:TextureToTensor"
    }
  },
  "steps": [
    {
      "name": "streams",
      "tool": "list_streams",
      "arguments": {},
      "expect": [
        { "at": "/streams", "has_length": 1 },
        { "at": "/streams/0/state", "equals": "running" }
      ]
    },
    {
      "name": "edit",
      "tool": "transact",
      "arguments": {
        "operations": [
          {
            "operation": "add_node",
            "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
            "type": { "$given": "source_node_type" },
            "as": { "$given": "source_label" },
            "config": { "$given": "source_config" }
          },
          {
            "operation": "add_node",
            "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
            "type": { "$given": "sink_node_type" },
            "as": { "$given": "sink_label" }
          },
          {
            "operation": "add_node",
            "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
            "type": { "$given": "clamp_node_type" },
            "as": { "$given": "clamp_label" }
          },
          {
            "operation": "add_node",
            "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
            "type": { "$given": "tensor_sink_node_type" },
            "as": { "$given": "tensor_sink_label" }
          }
        ]
      },
      "expect": [
        { "at": "/mode", "equals": "commit" },
        { "at": "/added_nodes", "has_length": 4 },
        { "at": "/added_nodes/0/as", "equals": { "$given": "source_label" } },
        { "at": "/added_nodes/1/as", "equals": { "$given": "sink_label" } },
        { "at": "/added_nodes/2/as", "equals": { "$given": "clamp_label" } },
        { "at": "/added_nodes/3/as", "equals": { "$given": "tensor_sink_label" } }
      ]
    },
    {
      "name": "link_checked_into_the_clamp",
      "tool": "check_link",
      "arguments": {
        "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
        "source": { "node": { "$read": { "step": "edit", "pointer": "/added_nodes/0/node" } }, "port": { "$given": "source_output" } },
        "target": { "node": { "$read": { "step": "edit", "pointer": "/added_nodes/2/node" } }, "port": { "$given": "clamp_input" } }
      },
      "expect": [
        { "at": "/outcome", "equals": "refused" },
        { "at": "/refusal/refusal_code", "equals": "link_pin_types_do_not_connect" },
        { "at": "/refusal/action", "equals": "connect" }
      ]
    },
    {
      "name": "link_checked_into_the_sink",
      "tool": "check_link",
      "arguments": {
        "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
        "source": { "node": { "$read": { "step": "edit", "pointer": "/added_nodes/0/node" } }, "port": { "$given": "source_output" } },
        "target": { "node": { "$read": { "step": "edit", "pointer": "/added_nodes/1/node" } }, "port": { "$given": "sink_input" } }
      },
      "expect": [
        { "at": "/outcome", "equals": "connects" }
      ]
    },
    {
      "name": "connected",
      "tool": "transact",
      "arguments": {
        "operations": [
          {
            "operation": "connect",
            "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
            "source": { "node": { "$read": { "step": "edit", "pointer": "/added_nodes/0/node" } }, "port": { "$given": "source_output" } },
            "target": { "node": { "$read": { "step": "edit", "pointer": "/added_nodes/1/node" } }, "port": { "$given": "sink_input" } }
          }
        ]
      },
      "expect": [
        { "at": "/mode", "equals": "commit" },
        { "at": "/connected_links", "has_length": 1 },
        { "at": "/connected_links/0/source/node", "equals": { "$read": { "step": "edit", "pointer": "/added_nodes/0/node" } } },
        { "at": "/connected_links/0/target/node", "equals": { "$read": { "step": "edit", "pointer": "/added_nodes/1/node" } } },
        { "at": "/connected_links/0/state", "is_one_of": ["pending", "wired"] }
      ]
    },
    {
      "name": "graph_after_the_edit",
      "tool": "graph",
      "arguments": {
        "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } }
      },
      "expect": [
        {
          "at": "/nodes",
          "holds_an_item_where": {
            "/id": { "$read": { "step": "edit", "pointer": "/added_nodes/0/node" } },
            "/type": { "$given": "source_node_type" }
          }
        },
        {
          "at": "/nodes",
          "holds_an_item_where": {
            "/id": { "$read": { "step": "edit", "pointer": "/added_nodes/1/node" } },
            "/type": { "$given": "sink_node_type" }
          }
        },
        {
          "at": "/links",
          "holds_an_item_where": {
            "/source/node": { "$read": { "step": "edit", "pointer": "/added_nodes/0/name" } },
            "/source/port": { "$given": "source_output" },
            "/target/node": { "$read": { "step": "edit", "pointer": "/added_nodes/1/name" } },
            "/target/port": { "$given": "sink_input" }
          }
        }
      ]
    },
    {
      "name": "link_checked_into_the_conversion",
      "tool": "check_link",
      "arguments": {
        "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
        "source": { "node": { "$read": { "step": "edit", "pointer": "/added_nodes/0/node" } }, "port": { "$given": "source_output" } },
        "target": { "node": { "$read": { "step": "edit", "pointer": "/added_nodes/3/node" } }, "port": { "$given": "tensor_sink_input" } }
      },
      "expect": [
        { "at": "/outcome", "equals": "connects_through_convert_node" },
        { "at": "/convert_node/node_type", "equals": { "$given": "convert_node_type" } }
      ]
    },
    {
      "name": "converted",
      "tool": "transact",
      "arguments": {
        "operations": [
          {
            "operation": "connect",
            "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } },
            "source": { "node": { "$read": { "step": "edit", "pointer": "/added_nodes/0/node" } }, "port": { "$given": "source_output" } },
            "target": { "node": { "$read": { "step": "edit", "pointer": "/added_nodes/3/node" } }, "port": { "$given": "tensor_sink_input" } }
          }
        ]
      },
      "expect": [
        { "at": "/mode", "equals": "commit" },
        { "at": "/added_nodes", "has_length": 1 },
        { "at": "/added_nodes/0/node_type", "equals": { "$given": "convert_node_type" } },
        { "at": "/added_nodes/0/inserted_because", "equals": "converts_pin_types" },
        { "at": "/connected_links", "has_length": 2 }
      ]
    },
    {
      "name": "graph_after_the_conversion",
      "tool": "graph",
      "arguments": {
        "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } }
      },
      "expect": [
        {
          "at": "/nodes",
          "holds_an_item_where": {
            "/id": { "$read": { "step": "converted", "pointer": "/added_nodes/0/node" } },
            "/type": { "$given": "convert_node_type" }
          }
        }
      ]
    },
    {
      "name": "conversion_undone",
      "tool": "undo",
      "arguments": {
        "project_directory": { "$read": { "step": "streams", "pointer": "/streams/0/location/project_directory" } }
      },
      "expect": [
        { "at": "/undoes", "equals": { "$read": { "step": "converted", "pointer": "/transaction" } } }
      ]
    },
    {
      "name": "graph_after_the_conversion_is_undone",
      "tool": "graph",
      "arguments": {
        "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } }
      },
      "expect": [
        {
          "at": "/nodes",
          "holds_no_item_where": {
            "/id": { "$read": { "step": "converted", "pointer": "/added_nodes/0/node" } }
          }
        },
        {
          "at": "/links",
          "holds_no_item_where": {
            "/target/node": { "$read": { "step": "edit", "pointer": "/added_nodes/3/name" } }
          }
        }
      ]
    },
    {
      "name": "link_undone",
      "tool": "undo",
      "arguments": {
        "project_directory": { "$read": { "step": "streams", "pointer": "/streams/0/location/project_directory" } }
      },
      "expect": [
        { "at": "/undoes", "equals": { "$read": { "step": "connected", "pointer": "/transaction" } } }
      ]
    },
    {
      "name": "undone",
      "tool": "undo",
      "arguments": {
        "project_directory": { "$read": { "step": "streams", "pointer": "/streams/0/location/project_directory" } }
      },
      "expect": [
        { "at": "/undoes", "equals": { "$read": { "step": "edit", "pointer": "/transaction" } } }
      ]
    },
    {
      "name": "graph_after_the_undo",
      "tool": "graph",
      "arguments": {
        "stream": { "$read": { "step": "streams", "pointer": "/streams/0/stream" } }
      },
      "expect": [
        {
          "at": "/nodes",
          "holds_no_item_where": {
            "/id": { "$read": { "step": "edit", "pointer": "/added_nodes/0/node" } }
          }
        },
        {
          "at": "/nodes",
          "holds_no_item_where": {
            "/id": { "$read": { "step": "edit", "pointer": "/added_nodes/1/node" } }
          }
        },
        {
          "at": "/nodes",
          "holds_no_item_where": {
            "/id": { "$read": { "step": "edit", "pointer": "/added_nodes/2/node" } }
          }
        },
        {
          "at": "/nodes",
          "holds_no_item_where": {
            "/id": { "$read": { "step": "edit", "pointer": "/added_nodes/3/node" } }
          }
        },
        {
          "at": "/links",
          "holds_no_item_where": {
            "/target/node": { "$read": { "step": "edit", "pointer": "/added_nodes/1/name" } }
          }
        }
      ]
    }
  ]
}
