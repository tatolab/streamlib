{
  "script": "author_a_node_ui_element",
  "task": {
    "statement": "In the project of the one stream the runtime holds, start a control named knob for float inputs from the extension SDK kit's template, as node_ui/knob.ts, and check that it passes; read it, write into it a knob drawn as a range slider that sets the slider's string value to the float, check it and read the refusal's code and place; write it again setting the slider's number value, and check that it passes.",
    "givens": {
      "element": {
        "kind": "control",
        "pin_type": "float",
        "control": "knob"
      },
      "script": "knob.ts",
      "script_path": "node_ui/knob.ts",
      "manifest_path": "node_ui/tatolab_node_ui.json",
      "control_source_with_a_mistake": "import type { ControlledPin, InputControlElement, InputControlState, StoredPinValue } from \"@tatolab/tato-app-view-sdk/node_ui\";\n\ntype PinTypeName = \"float\";\n\nexport default class Knob extends HTMLElement implements InputControlElement<PinTypeName> {\n  readonly #slider = document.createElement(\"input\");\n\n  constructor() {\n    super();\n    this.#slider.type = \"range\";\n    this.attachShadow({ mode: \"open\" }).append(this.#slider);\n  }\n\n  set pin({ declaration }: ControlledPin<PinTypeName>) {\n    this.#slider.setAttribute(\"aria-label\", declaration.label);\n  }\n\n  set value(value: StoredPinValue<PinTypeName>) {\n    this.#slider.value = value;\n  }\n\n  set state(state: InputControlState) {\n    this.#slider.disabled = state !== \"editable\";\n  }\n}\n",
      "control_source_fixed": "import type { ControlledPin, InputControlElement, InputControlState, StoredPinValue } from \"@tatolab/tato-app-view-sdk/node_ui\";\n\ntype PinTypeName = \"float\";\n\nexport default class Knob extends HTMLElement implements InputControlElement<PinTypeName> {\n  readonly #slider = document.createElement(\"input\");\n\n  constructor() {\n    super();\n    this.#slider.type = \"range\";\n    this.attachShadow({ mode: \"open\" }).append(this.#slider);\n  }\n\n  set pin({ declaration }: ControlledPin<PinTypeName>) {\n    this.#slider.setAttribute(\"aria-label\", declaration.label);\n  }\n\n  set value(value: StoredPinValue<PinTypeName>) {\n    this.#slider.valueAsNumber = value;\n  }\n\n  set state(state: InputControlState) {\n    this.#slider.disabled = state !== \"editable\";\n  }\n}\n",
      "refused_line": 19
    }
  },
