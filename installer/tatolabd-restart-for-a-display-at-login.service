#
# Restarts the Tatolab runtime when a desktop session starts, if the runtime
# started with no display server: at boot with linger, or at a login that
# started the user manager before the session imported its display. The
# runtime takes its display only at its start, so a window needs the restart.
# The marker is StreamlibRuntimeDirectory's
# runtime_started_with_no_display_server_marker_path. install.sh copies this
# beside tatolabd.service.

[Unit]
Description=Restart the Tatolab runtime for the display a desktop session brings
After=graphical-session.target
ConditionPathExists=%t/streamlib/tatolabd-started-with-no-display-server

[Service]
Type=oneshot
ExecStart=systemctl --user try-restart tatolabd.service

[Install]
WantedBy=graphical-session.target
