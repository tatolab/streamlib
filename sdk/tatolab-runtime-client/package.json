{
  "name": "@tatolab/runtime-client",
  "version": "0.68.92",
  "description": "The TypeScript client of the Tatolab runtime's control API, generated from its contract file.",
  "license": "BUSL-1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./contract.json": "./contract.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "runtime_client.js",
    "runtime_client.d.ts",
    "control_messages.js",
    "control_messages.d.ts",
    "control_transports.js",
    "control_transports.d.ts",
    "control_contract.js",
    "control_contract.d.ts",
    "control_schemas.js",
    "control_schemas.d.ts",
    "control_client.js",
    "control_client.d.ts",
    "contract.json",
    "REFERENCE.md"
  ],
  "dependencies": {
    "zod": "4.6.7"
  }
}
