{
  "permissions": {
    "allow": [
      "Bash(gh api *)",
      "Bash(gh pr *)",
      "Bash(git fetch *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list)",
      "Read(//proc/**)",
      "Read(//dev/**)",
      "Bash(nvidia-smi)",
      "Bash(nvidia-ctk --version)",
      "Bash(lscpu)",
      "Bash(lspci -nnk)",
      "Bash(flatpak list *)",
      "Bash(docker --version)",
      "Bash(docker info *)"
    ],
    "ask": [
      "Edit(./examples/**)",
      "Edit(./packages/audio/**)",
      "Edit(./packages/camera/**)",
      "Edit(./packages/clap/**)",
      "Edit(./packages/debug-utilities/**)",
      "Edit(./packages/display/**)",
      "Edit(./packages/frame-tap/**)",
      "Edit(./packages/h264/**)",
      "Edit(./packages/h265/**)",
      "Edit(./packages/jpeg/**)",
      "Edit(./packages/moq/**)",
      "Edit(./packages/mp4/**)",
      "Edit(./packages/opus/**)",
      "Edit(./packages/screen-capture/**)",
      "Edit(./packages/webrtc/**)",
      "Edit(vendor/tatolab-vulkanalia*/**)",
      "Edit(LICENSE)",
      "Edit(LICENSES/**)",
      "Edit(docs/license/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/rig-brake.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/plan-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-gc.sh"
          }
        ]
      }
    ]
  }
}
