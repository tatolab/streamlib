{
  "permissions": {
    "allow": [
      "Bash(gh api *)",
      "Bash(gh pr *)",
      "Bash(git fetch *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list)",
      "Bash(grep -c \"^{\\\\\"ts\\\\\":\\\\\"$\\(date -u +%F\\)\" .claude/loops/state/milestone-loop.run-log.jsonl)",
      "Read(//proc/**)",
      "Read(//dev/**)",
      "Bash(nvidia-smi)",
      "Bash(nvidia-ctk --version)",
      "Bash(lscpu)",
      "Bash(lspci -nnk)",
      "Bash(flatpak list *)",
      "Bash(docker --version)",
      "Bash(docker info *)"
    ],
    "deny": [
      "Edit(vendor/tatolab-vulkanalia*/**)",
      "Edit(LICENSE)",
      "Edit(LICENSES/**)",
      "Edit(docs/license/**)",
      "Edit(docs/logging-schema.md)",
      "Edit(docs/testing-hardware.md)",
      "Edit(docs/architecture/schema-identity-and-packaging.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/branch-shield.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/rig-brake.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/rs-sentinels.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-gc.sh"
          }
        ]
      }
    ]
  }
}
