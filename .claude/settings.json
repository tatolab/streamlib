{
  "permissions": {
    "allow": [
      "Bash(gh api *)",
      "Bash(gh pr *)",
      "Bash(git fetch *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list)",
      "Read(//proc/**)",
      "Read(//dev/**)",
      "Bash(nvidia-smi)",
      "Bash(nvidia-ctk --version)",
      "Bash(lscpu)",
      "Bash(lspci -nnk)",
      "Bash(flatpak list *)",
      "Bash(docker --version)",
      "Bash(docker info *)"
    ],
    "ask": [
      "Edit(LICENSE)",
      "Edit(LICENSES/**)",
      "Edit(docs/license/**)",
      "Write(LICENSE)",
      "Write(LICENSES/**)",
      "Write(docs/license/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/rig-brake.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-gc.sh"
          }
        ]
      }
    ]
  }
}
