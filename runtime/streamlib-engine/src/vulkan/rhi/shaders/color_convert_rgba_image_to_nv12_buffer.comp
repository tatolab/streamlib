//
// RGBA sampled-texture source → NV12 buffer dest color converter, the
// reverse of `color_convert_nv12_buffer_to_rgba.comp`.
//
// One thread writes a 4×2 pixel block: one uint of four luma bytes on each
// of its two rows, and one uint of two (Cb, Cr) pairs on its chroma row, each
// pair the box average of its 2×2 pixels. Pixels past the width or height
// repeat the last column or row, so every write lands inside a stride that
// holds the width rounded up to 4.
//
// Bindings:
//   0 — `sampler2D rgba_input` (fetched by integer texel, never filtered).
//   1 — `writeonly buffer Nv12Output` (uint-addressed; plane 0 at byte 0).
//
// Push constants — `core::rhi::color_converter::ColorConverterPushConstants`
// built by `from_resolved_for_rgb_to_ycbcr_nv12`: RGB→YCbCr matrix rows,
// `range_offset` added after the multiply, and both planes' strides and the
// chroma plane's offset, each a multiple of 4.

#version 450
#extension GL_GOOGLE_include_directive : require

#include "color_convert_common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D rgba_input;

layout(set = 0, binding = 1) writeonly buffer Nv12Output {
    uint data[];
} nv12_output;

layout(push_constant, std430) uniform PushConstants {
    vec4 matrix_row0;
    vec4 matrix_row1;
    vec4 matrix_row2;
    vec4 range_offset;
    uint width;
    uint height;
    uint transfer_in;
    uint transfer_out;
    uint flags;
    uint plane0_stride_bytes; // luma row stride in bytes (multiple of 4)
    uint plane1_stride_bytes; // chroma row stride in bytes (multiple of 4)
    uint plane1_offset_bytes; // chroma plane start in bytes (multiple of 4)
} pc;

// One pixel's byte-domain (Y, Cb, Cr) from its normalized RGB.
vec3 ycbcr_bytes_of(vec3 rgb) {
    if ((pc.flags & FLAG_APPLY_TRANSFER) != 0u) {
        rgb.r = transfer_from_linear(pc.transfer_out, transfer_to_linear(pc.transfer_in, rgb.r));
        rgb.g = transfer_from_linear(pc.transfer_out, transfer_to_linear(pc.transfer_in, rgb.g));
        rgb.b = transfer_from_linear(pc.transfer_out, transfer_to_linear(pc.transfer_in, rgb.b));
    }
    vec3 rgb_byte = clamp(rgb, 0.0, 1.0) * 255.0;
    vec3 ycbcr = vec3(
        dot(pc.matrix_row0.xyz, rgb_byte),
        dot(pc.matrix_row1.xyz, rgb_byte),
        dot(pc.matrix_row2.xyz, rgb_byte)
    ) + pc.range_offset.xyz;
    return clamp(ycbcr, 0.0, 255.0);
}

vec3 ycbcr_bytes_at(uint x, uint y) {
    uint clamped_x = min(x, pc.width - 1u);
    uint clamped_y = min(y, pc.height - 1u);
    return ycbcr_bytes_of(texelFetch(rgba_input, ivec2(int(clamped_x), int(clamped_y)), 0).rgb);
}

uint byte_of(float value) {
    return uint(round(value)) & 0xFFu;
}

void main() {
    uint x0 = gl_GlobalInvocationID.x * 4u;
    uint y0 = gl_GlobalInvocationID.y * 2u;
    if (x0 >= pc.width || y0 >= pc.height) return;

    vec3 top[4];
    vec3 bottom[4];
    for (uint column = 0u; column < 4u; column++) {
        top[column] = ycbcr_bytes_at(x0 + column, y0);
        bottom[column] = ycbcr_bytes_at(x0 + column, y0 + 1u);
    }

    uint top_luma = byte_of(top[0].x)
        | (byte_of(top[1].x) << 8u)
        | (byte_of(top[2].x) << 16u)
        | (byte_of(top[3].x) << 24u);
    nv12_output.data[(y0 * pc.plane0_stride_bytes + x0) >> 2u] = top_luma;
    if (y0 + 1u < pc.height) {
        uint bottom_luma = byte_of(bottom[0].x)
            | (byte_of(bottom[1].x) << 8u)
            | (byte_of(bottom[2].x) << 16u)
            | (byte_of(bottom[3].x) << 24u);
        nv12_output.data[((y0 + 1u) * pc.plane0_stride_bytes + x0) >> 2u] = bottom_luma;
    }

    vec2 left_chroma = 0.25 * (top[0].yz + top[1].yz + bottom[0].yz + bottom[1].yz);
    vec2 right_chroma = 0.25 * (top[2].yz + top[3].yz + bottom[2].yz + bottom[3].yz);
    uint chroma = byte_of(left_chroma.x)
        | (byte_of(left_chroma.y) << 8u)
        | (byte_of(right_chroma.x) << 16u)
        | (byte_of(right_chroma.y) << 24u);
    uint chroma_row = y0 >> 1u;
    nv12_output.data[(pc.plane1_offset_bytes + chroma_row * pc.plane1_stride_bytes + x0) >> 2u] =
        chroma;
}
