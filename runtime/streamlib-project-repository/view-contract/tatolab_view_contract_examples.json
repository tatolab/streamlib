      "opens": true,
      "reads_as": {
        "contract": "1.0",
        "title": "Notes",
        "entry": "dist/index.html",
        "placement": "area",
        "inputs": [],
        "outputs": [],
        "accepts": { "files": [] },
        "capabilities": []
      }
    },
