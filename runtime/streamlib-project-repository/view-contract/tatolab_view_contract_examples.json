{
  "contract": "1.0",
  "examples": [
    {
      "named": "a node view declaring every field",
      "manifest": {
        "contract": "1.0",
        "title": "Stage rig",
        "description": "Fixtures on a stage, with a master fader.",
        "icon": "icon.svg",
        "preview": "preview.png",
        "entry": "index.html",
        "placement": "node",
        "accepts": { "files": [".mvr", ".gdtf"] },
        "inputs": [
          {
            "name": "fixtures",
            "family": "records",
            "description": "Each fixture and where it hangs."
          }
        ],
        "outputs": [
          { "name": "master_intensity", "family": "array", "range": [0, 1] }
        ],
        "settings": {
          "type": "object",
          "properties": { "show_beams": { "type": "boolean", "default": true } }
        },
        "capabilities": ["read.selection", "read.project_assets"],
        "network": ["fixtures.example.com", "localhost:8080"],
        "sandbox": true
      },
      "opens": true
    },
    {
      "named": "an area view leaving out everything it may",
      "manifest": {
        "contract": "1.0",
        "title": "Notes",
        "entry": "dist/index.html",
        "placement": "area"
      },
      "opens": true,
      "reads_as": {
        "contract": "1.0",
        "title": "Notes",
        "entry": "dist/index.html",
        "placement": "area",
        "inputs": [],
        "outputs": [],
        "accepts": { "files": [] },
        "sandbox": false,
        "capabilities": [],
        "network": []
      }
    },
    {
      "named": "a title with space around it, and a capability asked for twice",
      "manifest": {
        "contract": "1.0",
        "title": "  Deck ",
        "entry": "index.html",
        "placement": "node",
        "capabilities": ["gpu", "gpu"]
      },
      "opens": true,
      "reads_as": {
        "contract": "1.0",
        "title": "Deck",
        "entry": "index.html",
        "placement": "node",
        "inputs": [],
        "outputs": [],
        "accepts": { "files": [] },
        "sandbox": false,
        "capabilities": ["gpu"],
        "network": []
      }
    },
