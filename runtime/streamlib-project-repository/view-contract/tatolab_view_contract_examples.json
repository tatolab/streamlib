{
  "contract": "1.1",
  "examples": [
    {
      "named": "a node view declaring every field",
      "manifest": {
        "contract": "1.0",
        "title": "Stage rig",
        "description": "Fixtures on a stage, with a master fader.",
        "icon": "icon.svg",
        "preview": "preview.png",
        "entry": "index.html",
        "placement": "node",
        "accepts": { "files": [".mvr", ".gdtf"] },
        "inputs": [
          {
            "name": "fixtures",
            "family": "records",
            "description": "Each fixture and where it hangs."
          }
        ],
        "outputs": [
          { "name": "master_intensity", "family": "array", "range": [0, 1] }
        ],
        "settings": {
          "type": "object",
          "properties": { "show_beams": { "type": "boolean", "default": true } }
        },
        "capabilities": ["read.selection", "read.project_assets", "camera", "microphone"]
      },
      "opens": true
    },
    {
      "named": "an area view leaving out everything it may",
      "manifest": {
        "contract": "1.0",
        "title": "Notes",
        "entry": "dist/index.html",
        "placement": "area"
