            },
            "required": [
              "default"
            ],
            "additionalProperties": {}
          }
        },
        "additionalProperties": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "properties"
      ],
      "additionalProperties": {}
    },
    "sandbox": {
      "default": false,
