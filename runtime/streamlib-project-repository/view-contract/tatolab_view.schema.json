    },
    "network": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?=.{1,253}(:|$))[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*(:[0-9]{1,5})?$"
      }
    }
  },
  "required": [
