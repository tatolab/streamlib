{
  "title": "tatolab_view.json, view contract 1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "minLength": 1
    },
    "preview": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "placement": {
      "type": "string",
      "enum": [
        "area",
        "node"
      ]
    },
    "inputs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$"
          },
          "family": {
            "type": "string",
            "enum": [
              "image",
              "array",
              "channels",
              "packets",
              "records"
            ]
          },
          "description": {
            "type": "string"
          },
          "range": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "name",
          "family"
        ]
      }
    },
    "outputs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$"
          },
          "family": {
            "type": "string",
            "enum": [
              "image",
              "array",
              "channels",
              "packets",
              "records"
            ]
          },
          "description": {
            "type": "string"
          },
          "range": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "name",
          "family"
        ]
      }
    },
    "accepts": {
      "default": {
        "files": []
      },
      "type": "object",
      "properties": {
        "files": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.[a-z0-9]+$"
          }
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "object"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "default": {
                "$ref": "#/$defs/__schema0"
