flowchart LR
  subgraph env["One uv-managed venv — one Python, ordinary Python package deps only"]
    app["User Python app\n(app.py setup(rt) — normal codebase;\nhosts no processor)"]
    procs["User processor classes\n(importable modules — imported by the app,\nregistering their descriptor as the decorator runs, by helpers to run;\nnever hosted in the app;\nthe class's import path is its identity)"]
    pkgs["Extension wheels\n(ordinary PyPI packages — Rust inside for speed, a Python processor\nas the binding; depend on the streamlib wheel as a binary, never link the engine;\nnative internals expose handles, never streamlib internals;\ntwo mechanisms — a processor extension added by rt.add that calls its own\nRust directly, and a capability extension: support code declared by a pyproject\nentry point pip records, run once at startup like a driver, sandboxed, able to\nintroduce engine-grade capabilities the engine does not provide; first-party optional capabilities ship this way too,\nnetworking shipped first — streamlib-webrtc (WhipPublisher / WhepPlayer) and\nstreamlib-moq (MoqBroadcastPublisher / MoqBroadcastSubscriber), both on the encoded\nside of the codec blocks, touching no surface and no GPU;\nthe MoQ pair also carries data tracks under streamlib_bag — any bag as a track\nbeside video and audio, named by track_names, the producer's stamp intact,\na late media bag shed and its backlogged group abandoned on the vendored moq-transport;\ngraph carries what loaded as its extensions key;\nlive in packages/, local-linked in-repo,\npublished via the wheel's multi-project index)"]
    wheel["streamlib wheel\n(Python API + CLI + engine, PyO3 —\nrepo releases now, PyPI after rename;\nits bag codec is exported as the one encode/decode pair\nan extension carrying a bag over its own transport reaches)"]
    helper["Helper processes — every Python processor\n(engine exec of sys.executable; own\ninterpreter, own GIL; imports the wheel —\nand refuses to start unless that wheel is the\nparent's own engine build, id checked before\nany channel or socket opens;\nthe only placement)"]
  end

  rustapp["Rust app\n(plain cargo project)"]
  crate["streamlib crate\n(embeddable Rust library)"]
  engine["Engine runtime\n(runtime/streamlib-engine)"]
  media["Built-in media blocks\n(camera / display / MicrophoneSource / SpeakerSink — native,\nin the wheel, handle-shaped primitives;\naudio backend dlopen'd: PipeWire → ALSA → null,\nchosen by opening not by loading; vendored SPA headers\ncompile to a shim that calls only pointers, so no audio\nlibrary enters DT_NEEDED;\ndevice-paced, conditioning on the built-ins;\ncodec blocks: H264/H265 encode+decode shipped on Vulkan Video sessions,\none encode body and one decode body specialised by codec identity,\ncolour conversion on the engine's existing rgb_to_nv12 — no new RHI primitive;\nall four reach Python as marker classes like every other built-in, and the\nencoded frame has a Python cast (EncodedVideoFrame) holding no surface;\nOpus encode+decode shipped over statically linked libopus, and a pure-Rust\nfragmented Mp4Sink muxing both — one track per inbound link, named by its channel;\nJpegDecoder frozen until its drone consumer returns, and the next codec\nfollows the built-in criterion rather than joining this node — an encoded frame is an\nordinary bag, bitstream inline as bin beside the ordering pair and sync-point flag;\nan encoded audio packet is that convention applied to audio, cast by EncodedAudioPacket;\na decoder publishes the SPS display window, never the padded coded picture;\nVirtualCameraSink: one camera per processor, created at setup and removed at teardown,\nthat any other application on the machine opens — built-in under criterion (c),\ntwo doors chosen at setup and logged: a v4l2loopback device it creates through the\nmodule's control node, YUYV written by one GPU pass through the RHI's host-pointer\nimport (cached-staging copy where the driver refuses it, imported on the rig), else a\nPipeWire Video/Source node with media.role = Camera over the same dlsym'd shim, whose\nvideo half shares the audio half's entry-point list; the loopback permission is a\none-time enable-virtual-camera the user runs, never elevated by the engine)"]
  rhi["RHI\n(vulkan/rhi + streamlib-consumer-rhi)"]
  interop["Interop adapters\n(Vulkan↔CUDA, Vulkan↔GL — app-process Rust)"]
  ctl["Control plane\n(api-server: HTTP / WS / MCP — engine-side;\nserves the processor catalog — every registered type with its derived\nconfig schema and ports — the live graph, and recipes over its tools)"]
  cli["CLI (in the wheel)\nnew / dev / run · nodes / graph / tap / logs / exchange · enable-virtual-camera"]
  wire["Wire\n(self-describing bags between nodes —\nthe only cross-language boundary)"]

  registry["Node registry\n(one JSON per live node, inside the one engine-resolved runtime\ndirectory — on Linux XDG_RUNTIME_DIR/streamlib where that is set and non-empty,\notherwise, and on macOS always, /tmp/streamlib-<uid>, owner-only and checked\nbefore the first write — which also holds the\nsurface socket and the engine-owned iceoryx2 domain)"]
  mesh["Runtime mesh (Zenoh)\n(engine transport, always on, beside iceoryx2 — one session per runtime,\nopened in Runner::new() from engine defaults and closed at stop(), never in a helper;\na runtime announces itself with a liveliness token plus a description queryable and\ndiscovers peers peer-to-peer, explicit peers or a router where multicast\ndoes not cross; a session that cannot bind runs local-only and says why once;\nname and mesh come from the constructor, the environment or the CLI and nowhere else;\neverything under a mesh name, default `default`, no off switch;\nports addressed runtime name / display name / port, the runtime name unique\nin the mesh; any runtime may create a remote link — the input's runtime applies it\nwith connect's own refusals, a missing runtime waits, a missing port is refused;\nnothing is sent for a port no remote link reads; stamps cross unchanged tagged with\ntheir clock, never compared across clocks (a shared network clock is OPEN);\na send the network cannot take is dropped and counted per remote link;\nnotify, event bus, request-response and blackboard never cross;\ngraph lists mesh peers; a top-level surface_id crosses as pixels and lands as a fresh\nlocal surface id; no auth yet — the auth posture owns it)"]

